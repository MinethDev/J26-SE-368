# Copy this file to .env and fill in your own values. Never commit .env.

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/devintel
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# AI component services (Contract 3)
PLANNING_SERVICE_URL=http://127.0.0.1:8001
SPRINT_SERVICE_URL=http://127.0.0.1:8002
QUALITY_SERVICE_URL=http://127.0.0.1:8003
PR_SERVICE_URL=http://127.0.0.1:8004
SERVICE_TIMEOUT_MS=300000

# GitHub connector: personal access token (read-only repo scope is enough)
GITHUB_TOKEN=

# Jira connector (Jira Cloud): your Atlassian email + API token
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Story points live in a custom field; find its id in Jira (e.g. customfield_10016)
JIRA_STORY_POINTS_FIELD=customfield_10016

# SonarQube connector: server URL + user token
SONARQUBE_URL=
SONARQUBE_TOKEN=
